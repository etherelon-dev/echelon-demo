# Estyalife — konfigurasi Agent AI (Fase 2)
#
# Salin file ini jadi ".env.local" lalu isi salah satu (atau beberapa) kunci
# di bawah supaya route server (src/app/api/ai/route.ts) punya kunci
# default untuk Agent tersebut. Ini SEPENUHNYA OPSIONAL — pemain juga bisa
# mengisi token API miliknya sendiri lewat panel "Pengaturan Agent AI" di
# dalam permainan (disimpan lokal di IndexedDB browser pemain, TIDAK PERNAH
# dikirim ke server ini secara permanen maupun ikut ter-export bersama save
# game — lihat src/lib/ai/apiKeyStore.ts).
#
# Pemain bisa memilih salah satu dari TIGA Agent AI, dan menukarnya kapan
# saja — termasuk di tengah permainan yang sedang berjalan.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Gemini (Google) ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- ChatGPT (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
